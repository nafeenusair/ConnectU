# .env.example
# Copy this file to .env and fill in your secrets

# Django secret key
# Generate a unique value with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-unique-django-secret-key

# Database settings
DB_NAME=your-db-name
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Other sensitive variables
# EMAIL_HOST_PASSWORD=your-email-password

#DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
